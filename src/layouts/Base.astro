---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, LOCALE_TAGS, OG_LOCALES, SITE_NAME, SITE_URL, type Locale } from '../config';
import { localePath, stripLocale, useTranslations, withBase } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Extra JSON-LD blocks, serialised as-is. */
  jsonLd?: Record<string, unknown>[];
  /** `website` (default) or `article` for long-form legal pages. */
  ogType?: 'website' | 'article';
  /** Error/utility pages: `noindex`, no canonical/hreflang, no language switcher. */
  noindex?: boolean;
}

const { locale, title, description, jsonLd = [], ogType = 'website', noindex = false } = Astro.props;
const t = useTranslations(locale);

const path = stripLocale(Astro.url.pathname);
const canonical = new URL(localePath(locale, path), SITE_URL).href;
const alternates = LOCALES.map((l) => ({
  locale: l,
  href: new URL(localePath(l, path), SITE_URL).href,
}));
const ogImage = new URL(withBase('/og.png'), SITE_URL).href;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} · ${t.meta.siteSuffix}`;
---

<html lang={LOCALE_TAGS[locale]} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0B0C" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F6F4EE" />
    {/* Stamp the stored theme before first paint so there is no flash. The only client JS on the site. */}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={LOCALE_TAGS[a.locale]} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALES[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-instrument-serif" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin' }]} />

    {jsonLd.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body class="flex min-h-full flex-col bg-bg text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-lime-fill focus:px-4 focus:py-2 focus:text-lime-ink"
    >
      {t.nav.skipToContent}
    </a>
    <Header locale={locale} showLangSwitcher={!noindex} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script is:inline>
      (function (r, bs) {
        function sync() {
          var c = r.dataset.theme || 'system';
          bs.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.setTheme === c)); });
        }
        bs.forEach(function (b) {
          b.onclick = function () {
            var v = b.dataset.setTheme;
            v === 'system' ? delete r.dataset.theme : (r.dataset.theme = v);
            try { v === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', v); } catch (e) {}
            sync();
          };
        });
        sync();
      })(document.documentElement, document.querySelectorAll('[data-set-theme]'));
    </script>
  </body>
</html>
