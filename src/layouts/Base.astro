---
import { Font } from 'astro:assets'
import '../styles/global.css'
import Footer from '../components/organisms/Footer.astro'
import LiquidGlassBubble from '../components/organisms/LiquidGlassBubble.astro'
import SiteControls from '../components/organisms/SiteControls.astro'
import { APP_NAME, LOCALES, LOCALE_TAGS, OG_LOCALES, SITE_URL, type Locale } from '../config'
import { localePath, stripLocale, useTranslations, withBase } from '../i18n'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Extra JSON-LD blocks, serialised as-is. */
  jsonLd?: Record<string, unknown>[]
  /** `website` (default) or `article` for long-form legal pages. */
  ogType?: 'website' | 'article'
  /** Error/utility pages: `noindex`, no canonical/hreflang, no language switcher. */
  noindex?: boolean
  /** Show the theme bubble in SiteControls. Defaults to true. */
  showThemeBubble?: boolean
  /** Per-project accent colours injected on <html> as CSS custom properties. */
  projectAccent?: { accent: string; accentDark: string; accentInk: string }
  /** Footer variant: 'project' (default) or 'portfolio' (directory page). */
  footerVariant?: 'portfolio' | 'project'
}

const {
  locale,
  title,
  description,
  jsonLd = [],
  ogType = 'website',
  noindex = false,
  showThemeBubble = true,
  projectAccent,
  footerVariant = 'project',
} = Astro.props
const t = useTranslations(locale)

const path = stripLocale(Astro.url.pathname)
const canonical = new URL(localePath(locale, path), SITE_URL).href
const alternates = LOCALES.map((l) => ({
  locale: l,
  href: new URL(localePath(l, path), SITE_URL).href,
}))
const ogImage = new URL(withBase('/og.png'), SITE_URL).href
---

<html
  lang={LOCALE_TAGS[locale]}
  class="h-full antialiased"
  style={
    projectAccent
      ? `--project-accent:${projectAccent.accent};--project-accent-dark:${projectAccent.accentDark};--project-accent-ink:${projectAccent.accentInk}`
      : undefined
  }
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0B0C" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F6F4EE" />
    {/* Stamp the stored theme before first paint so there is no flash. The only client JS on the site. */}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex &&
      alternates.map((a) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[a.locale]} href={a.href} />
      ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-instrument-serif" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin' }]} />

    {jsonLd.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="flex min-h-full flex-col bg-bg text-fg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-lime-fill focus:px-4 focus:py-2 focus:text-lime-ink"
    >
      {t.nav.skipToContent}
    </a>
    <LiquidGlassBubble locale={locale} />
    <SiteControls locale={locale} showTheme={showThemeBubble} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} variant={footerVariant} />
    <script is:inline>
      ;(function (r, bs) {
        function sync() {
          var c = r.dataset.theme || 'system'
          bs.forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.setTheme === c))
          })
        }
        bs.forEach(function (b) {
          b.onclick = function () {
            var v = b.dataset.setTheme
            if (v === 'system') {
              delete r.dataset.theme
            } else {
              r.dataset.theme = v
            }
            try {
              if (v === 'system') {
                localStorage.removeItem('theme')
              } else {
                localStorage.setItem('theme', v)
              }
            } catch {}
            sync()
          }
        })
        sync()
      })(document.documentElement, document.querySelectorAll('[data-set-theme]'))
    </script>
  </body>
</html>
