---
import { Image } from 'astro:assets'
import { localePath, stripLocale, useTranslations } from '../../i18n'
import { DEVELOPER_LINKEDIN, DEVELOPER_NAME, type Locale } from '../../config'
import avatar from '../../assets/avatar/xavi.jpg'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
---

<nav class="bubble" aria-label={t.nav.bubble.label} data-testid="site-bubble">
  <a
    href={localePath(locale)}
    class="bubble__nav"
    data-testid="bubble-projects"
    aria-current={stripLocale(Astro.url.pathname) === '/' ? 'page' : undefined}
  >
    <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <rect x="0" y="0" width="6" height="6" rx="1.5" fill="currentColor" opacity=".9" />
      <rect x="8" y="0" width="6" height="6" rx="1.5" fill="currentColor" opacity=".9" />
      <rect x="0" y="8" width="6" height="6" rx="1.5" fill="currentColor" opacity=".9" />
      <rect x="8" y="8" width="6" height="6" rx="1.5" fill="currentColor" opacity=".9" />
    </svg>
    <span class="bubble__label">{t.nav.bubble.projects}</span>
  </a>

  <div class="bubble__sep" aria-hidden="true"></div>

  <a
    href={DEVELOPER_LINKEDIN}
    target="_blank"
    rel="noopener noreferrer"
    class="bubble__profile"
    aria-label={t.nav.bubble.linkedinAria}
    data-testid="bubble-profile"
  >
    <Image
      src={avatar}
      alt=""
      width={28}
      height={28}
      densities={[1, 2]}
      loading="eager"
      class="bubble__avatar"
      data-testid="bubble-avatar"
    />
    <span class="bubble__name">{DEVELOPER_NAME.split(' ')[0]}</span>
    <span class="bubble__li-logo" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <rect width="24" height="24" rx="5" fill="#0A66C2" />
        <path
          d="M7.75 9.5v9H5.25v-9h2.5zm-1.25-4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zM10.75 9.5v1.22A3.5 3.5 0 0 1 13.6 9.5c2.65 0 3.9 1.6 3.9 4.35V18.5H15v-4.35c0-1.55-.7-2.4-2.1-2.4-1.5 0-2.15 1-2.15 2.65V18.5H8.25v-9h2.5z"
          fill="white"
        />
      </svg>
    </span>
  </a>
</nav>

<style>
  .bubble {
    position: fixed;
    top: 0.8125rem;
    left: 1.25rem;
    z-index: 50;
    display: flex;
    align-items: center;
    border-radius: 99px;
    /* dark glass */
    background: rgba(16, 16, 20, 0.68);
    backdrop-filter: blur(32px) saturate(180%) brightness(105%);
    -webkit-backdrop-filter: blur(32px) saturate(180%) brightness(105%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 8px 40px rgba(0, 0, 0, 0.4),
      0 2px 8px rgba(0, 0, 0, 0.2);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .bubble {
      background: rgba(255, 255, 255, 0.78);
      border-color: rgba(0, 0, 0, 0.07);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.95),
        0 8px 40px rgba(0, 0, 0, 0.08),
        0 2px 8px rgba(0, 0, 0, 0.06);
    }
  }
  :root[data-theme='light'] .bubble {
    background: rgba(255, 255, 255, 0.78);
    border-color: rgba(0, 0, 0, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 8px 40px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .bubble__nav {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.15s;
    border-radius: 99px 0 0 99px;
  }
  .bubble__nav:hover {
    color: #fff;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .bubble__nav {
      color: rgba(0, 0, 0, 0.6);
    }
    :root:not([data-theme='dark']) .bubble__nav:hover {
      color: #000;
    }
  }
  :root[data-theme='light'] .bubble__nav {
    color: rgba(0, 0, 0, 0.6);
  }
  :root[data-theme='light'] .bubble__nav:hover {
    color: #000;
  }

  .bubble__sep {
    width: 1px;
    height: 18px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.12);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .bubble__sep {
      background: rgba(0, 0, 0, 0.1);
    }
  }
  :root[data-theme='light'] .bubble__sep {
    background: rgba(0, 0, 0, 0.1);
  }

  .bubble__profile {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px 5px 12px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.15s;
    border-radius: 0 99px 99px 0;
  }
  .bubble__profile:hover {
    color: #fff;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .bubble__profile {
      color: rgba(0, 0, 0, 0.6);
    }
    :root:not([data-theme='dark']) .bubble__profile:hover {
      color: #000;
    }
  }
  :root[data-theme='light'] .bubble__profile {
    color: rgba(0, 0, 0, 0.6);
  }
  :root[data-theme='light'] .bubble__profile:hover {
    color: #000;
  }

  .bubble__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
  }

  .bubble__label,
  .bubble__name {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .bubble__li-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.9;
  }

  @media (max-width: 480px) {
    .bubble__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .bubble__name {
      display: none;
    }
    .bubble__li-logo {
      display: none;
    }
  }
</style>
