---
import { localePath } from '../../i18n';
import type { Locale } from '../../config';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<div class="glass-bubble">
  <a href={localePath(locale, '/')} class="glass-bubble__link">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="1" y="1" width="6" height="6" rx="1" fill="currentColor"/>
      <rect x="9" y="1" width="6" height="6" rx="1" fill="currentColor"/>
      <rect x="1" y="9" width="6" height="6" rx="1" fill="currentColor"/>
      <rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"/>
    </svg>
    <span class="glass-bubble__label">Projects</span>
  </a>
  <div class="glass-bubble__sep" aria-hidden="true"></div>
  <a href="https://www.linkedin.com/in/xavimorenom" target="_blank" rel="noopener noreferrer"
     class="glass-bubble__link" aria-label="LinkedIn">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M13.5 1h-11A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 13.5 1ZM5.5 13H3.5V6.5h2V13Zm-1-7.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2ZM13 13h-2V9.75C11 8.79 10.21 8 9.25 8S7.5 8.79 7.5 9.75V13h-2V6.5h2v.97A2.74 2.74 0 0 1 9.25 6.5c1.52 0 3.75.88 3.75 3.25V13Z" fill="currentColor"/>
    </svg>
  </a>
</div>
<style>
  .glass-bubble {
    position: fixed; top: 1rem; left: 1rem; z-index: 45;
    display: flex; align-items: center;
    padding: 0.4rem 0.75rem;
    background: rgba(0,0,0,0.22);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 9999px;
    color: rgba(255,255,255,0.75);
  }
  :root[data-theme="light"] .glass-bubble {
    background: rgba(255,255,255,0.55);
    border-color: rgba(255,255,255,0.70);
    color: rgba(0,0,0,0.65);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .glass-bubble {
      background: rgba(255,255,255,0.55);
      border-color: rgba(255,255,255,0.70);
      color: rgba(0,0,0,0.65);
    }
  }
  .glass-bubble__link {
    display: flex; align-items: center; gap: 0.4rem;
    text-decoration: none; color: inherit;
    padding: 0.1rem 0.25rem;
    transition: opacity 0.15s;
  }
  .glass-bubble__link:hover { opacity: 1; color: var(--fg, inherit); }
  .glass-bubble__sep {
    width: 1px; height: 1.1em;
    background: rgba(255,255,255,0.20);
    margin: 0 0.5rem; flex-shrink: 0;
  }
  :root[data-theme="light"] .glass-bubble__sep { background: rgba(0,0,0,0.12); }
  .glass-bubble__label { font-size: 0.75rem; font-weight: 500; }
  @media (max-width: 639px) { .glass-bubble__label { display: none; } }
</style>
