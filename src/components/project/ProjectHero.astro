---
import PhoneFrame from '../molecules/PhoneFrame.astro'
import TerminalFrame from './TerminalFrame.astro'
import type { Project } from '../../content/projects/index'
import type { Locale } from '../../config'
import { useTranslations } from '../../i18n'
interface Props {
  project: Project
  locale: Locale
}
const { project, locale } = Astro.props
const t = useTranslations(locale)
const isCli = project.platform.includes('cli')
const isIos = project.platform.includes('ios')
const isMacos = project.platform.includes('macos')
const isMixed = isCli && isMacos
const projectT = (t.projects as Record<string, { tagline: string; description: string }>)[
  project.slug
] ?? { tagline: '', description: '' }
const hasScreenshot = !!project.screenshot
---

<section
  class:list={[
    'px-5 py-20 sm:px-8 sm:py-28 relative overflow-hidden',
    isCli || isMixed ? 'bg-[#0D1117]' : 'hero-ios-bg',
  ]}
  style={`--project-accent:${project.accent};--project-accent-dark:${project.accentDark};--project-accent-ink:${project.accentInk}`}
>
  <div class="mx-auto max-w-6xl">
    <div
      class:list={[
        'flex gap-12',
        isMixed ? 'flex-col lg:flex-row' : 'flex-col md:flex-row items-center',
      ]}
    >
      <!-- Left: copy -->
      <div class="flex-1 flex flex-col justify-center">
        <div class="flex flex-wrap gap-1.5 mb-5">
          {project.platform.map((p) => (
            <span class="rounded-full border border-white/10 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-white/40">
              {t.directory.platformBadge[p]}
            </span>
          ))}
        </div>
        <h1 class="display text-5xl text-fg sm:text-6xl md:text-7xl">
          {project.name}
          <span style="color:var(--project-accent)">.</span>
        </h1>
        <p class="display mt-4 max-w-xl text-2xl text-muted sm:text-3xl">{projectT.tagline}</p>
        <p class="mt-6 max-w-lg text-base leading-relaxed text-muted">{projectT.description}</p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
          {project.appStoreUrl && (
            <a href={project.appStoreUrl} target="_blank" rel="noopener" class="hero-cta">
              Download on the App Store
            </a>
          )}
          {project.testflightUrl && !project.appStoreUrl && (
            <a href={project.testflightUrl} target="_blank" rel="noopener" class="hero-cta">
              Join the TestFlight beta
            </a>
          )}
          {project.installCommand && (
            <div class="flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 font-mono text-sm text-white/80">
              <code>{project.installCommand}</code>
            </div>
          )}
          {project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener"
              class="text-sm text-white/40 hover:text-white/70 transition-colors"
            >
              GitHub ↗
            </a>
          )}
        </div>
      </div>

      <!-- Right: visual -->
      {hasScreenshot && (
        <div class:list={[isMixed ? 'lg:w-1/2' : 'md:w-2/5']}>
          {isIos && !isCli && (
            <PhoneFrame>
              <img
                src={project.screenshot}
                alt={project.name}
                class="w-full h-auto"
                loading="eager"
              />
            </PhoneFrame>
          )}
          {isMixed && (
            <div class="macos-frame">
              <div class="macos-frame__bar">
                <span class="macos-frame__dot" style="background:#FF5F57"></span>
                <span class="macos-frame__dot" style="background:#FEBC2E"></span>
                <span class="macos-frame__dot" style="background:#28C840"></span>
                <span class="macos-frame__title">{project.name}</span>
              </div>
              <div class="macos-frame__body">
                <img
                  src={project.screenshot}
                  alt={project.name}
                  class="shot-light w-full h-auto block"
                  loading="eager"
                />
                <img
                  src={project.screenshotDark ?? project.screenshot}
                  alt={project.name}
                  class="shot-dark w-full h-auto block"
                  loading="eager"
                />
              </div>
            </div>
          )}
          {isCli && !isMixed && (
            <TerminalFrame title={project.name.toLowerCase()}>
              <slot name="tui" />
            </TerminalFrame>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero-ios-bg {
    background: linear-gradient(
      160deg,
      var(--bg) 40%,
      color-mix(in srgb, var(--project-accent-dark) 12%, var(--bg)) 100%
    );
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    background: var(--project-accent);
    color: var(--project-accent-ink);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .hero-cta:hover {
    opacity: 0.88;
  }

  /* macOS window chrome */
  .macos-frame {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.5),
      0 8px 20px rgba(0, 0, 0, 0.3);
  }
  .macos-frame__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #2a2a2e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .macos-frame__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .macos-frame__title {
    flex: 1;
    text-align: center;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.4);
    margin-right: 36px; /* offset traffic lights */
  }
  .macos-frame__body {
    background: #1c1c1e;
  }

  /* theme-switched screenshots */
  .shot-light {
    display: var(--shot-light, block);
  }
  .shot-dark {
    display: var(--shot-dark, none);
  }
</style>
