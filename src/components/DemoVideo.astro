---
/**
 * Demo video section body. Looks for `public/video/*.{webm,mp4}` at build time
 * (webm listed first, mp4 as fallback) and `public/video/poster.{jpg,png,webp}`.
 * If no video exists → phone-frame placeholder.
 *
 * Theme-aware: files whose name ends in `-dark.<ext>` form the dark set
 * (`alterio-demo-dark.webm`, poster `poster-dark.jpg`); the rest form the light
 * set. When both exist, both <video>s are rendered and CSS shows exactly one
 * (`.shot-light` / `.shot-dark`, see global.css). With a single set it is used
 * for every theme.
 *
 * TODO(media): copy the export from media/video/ into public/video/ (plus a
 * poster frame) — nothing else needs to change.
 */
import { existsSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import type { Locale } from '../config';
import { useTranslations, withBase } from '../i18n';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Resolved from the project root: `import.meta.url` points at the bundled chunk at build time.
const dir = resolve('public/video');
const files = existsSync(dir) ? readdirSync(dir) : [];
const isDark = (f: string) => /-dark\.[a-z0-9]+$/i.test(f);

interface VideoSet {
  sources: { src: string; type: string }[];
  poster: string | undefined;
}
function setFor(dark: boolean): VideoSet {
  const own = files.filter((f) => isDark(f) === dark);
  return {
    sources: [
      ...own.filter((f) => f.endsWith('.webm')).map((f) => ({ src: withBase(`/video/${f}`), type: 'video/webm' })),
      ...own.filter((f) => f.endsWith('.mp4')).map((f) => ({ src: withBase(`/video/${f}`), type: 'video/mp4' })),
    ],
    poster: own.find((f) => /^poster(-dark)?\.(jpe?g|png|webp)$/.test(f)),
  };
}

const light = setFor(false);
const dark = setFor(true);
const themed = light.sources.length > 0 && dark.sources.length > 0;
const single = light.sources.length ? light : dark;
const hasVideo = single.sources.length > 0;
const sets: { set: VideoSet; cls: string }[] = themed
  ? [
      { set: light, cls: 'shot-light' },
      { set: dark, cls: 'shot-dark' },
    ]
  : [{ set: single, cls: '' }];
---

<div class="mx-auto w-full max-w-[300px]">
  {
    hasVideo ? (
      <PhoneFrame>
        {sets.map(({ set, cls }) => (
          <video
            class={`h-full w-full object-cover ${cls}`}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={set.poster ? withBase(`/video/${set.poster}`) : undefined}
            aria-label={t.product.videoHeading}
          >
            {set.sources.map((s) => (
              <source src={s.src} type={s.type} />
            ))}
            {t.product.videoUnsupported}
          </video>
        ))}
      </PhoneFrame>
    ) : (
      <div class="relative">
        <PhoneFrame variant={1} label={t.product.videoPlaceholder} />
        <span
          aria-hidden="true"
          class="absolute top-1/2 left-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-lime-fill/90 text-lime-ink shadow-lg"
        >
          <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7" fill="currentColor">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
      </div>
    )
  }
</div>
