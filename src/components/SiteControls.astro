---
/**
 * Right-side fixed controls: language selector and theme switcher.
 * Two 40px glass pills, 8px gap, top-right corner. Each opens a dropdown panel.
 */
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, type Locale } from '../config'
import { localePath, stripLocale, useTranslations } from '../i18n'
import { THEME_ICONS } from './theme-icons'

interface Props {
  locale: Locale
  showLang?: boolean
  showTheme?: boolean
}

const { locale, showLang = true, showTheme = true } = Astro.props
const t = useTranslations(locale)
const path = stripLocale(Astro.url.pathname)
const otherLocales = LOCALES.filter((l) => l !== locale)

const themeOptions = [
  { value: 'system' as const, label: t.nav.theme.system },
  { value: 'light' as const, label: t.nav.theme.light },
  { value: 'dark' as const, label: t.nav.theme.dark },
]

function flagSvg(loc: Locale): string {
  if (loc === 'en') {
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 18" width="27" height="18" aria-hidden="true" data-flag="en" style="border-radius:2px;box-shadow:inset 0 0 0 .5px rgba(0,0,0,.18);flex-shrink:0"><defs><clipPath id="flag-en-clip"><rect width="27" height="18" rx="2"/></clipPath></defs><g clip-path="url(#flag-en-clip)"><rect width="27" height="18" fill="#012169"/><line x1="-1" y1="-1" x2="28" y2="19" stroke="white" stroke-width="5.4"/><line x1="28" y1="-1" x2="-1" y2="19" stroke="white" stroke-width="5.4"/><line x1="-1" y1="-1" x2="28" y2="19" stroke="#C8102E" stroke-width="2.7"/><line x1="28" y1="-1" x2="-1" y2="19" stroke="#C8102E" stroke-width="2.7"/><rect x="10.5" y="0" width="6" height="18" fill="white"/><rect x="0" y="6" width="27" height="6" fill="white"/><rect x="11.5" y="0" width="4" height="18" fill="#C8102E"/><rect x="0" y="7" width="27" height="4" fill="#C8102E"/></g></svg>`
  }
  if (loc === 'es') {
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 18" width="27" height="18" aria-hidden="true" data-flag="es" style="border-radius:2px;box-shadow:inset 0 0 0 .5px rgba(0,0,0,.18);flex-shrink:0"><rect width="27" height="18" rx="2" fill="#AA151B"/><rect x="0" y="4.5" width="27" height="9" fill="#F1BF00"/></svg>`
  }
  // ca — Senyera: gold background, 4 red horizontal bands
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 18" width="27" height="18" aria-hidden="true" data-flag="ca" style="border-radius:2px;box-shadow:inset 0 0 0 .5px rgba(0,0,0,.18);flex-shrink:0"><rect width="27" height="18" rx="2" fill="#FCDD09"/><rect x="0" y="2" width="27" height="2" fill="#DA121A"/><rect x="0" y="6" width="27" height="2" fill="#DA121A"/><rect x="0" y="10" width="27" height="2" fill="#DA121A"/><rect x="0" y="14" width="27" height="2" fill="#DA121A"/></svg>`
}
---

<div class="site-controls" data-testid="site-controls">
  {showLang !== false && (
    <nav
      class="bubble-host rb"
      aria-label={t.nav.language}
      data-testid="lang-bubble"
      data-open="false"
    >
      <button
        type="button"
        class="bubble-glass rb__trigger"
        data-bubble-trigger
        aria-expanded="false"
        aria-controls="lang-bubble-panel"
        aria-label={`${t.nav.language}: ${LOCALE_LABELS[locale]}`}
        data-testid="lang-bubble-trigger"
      >
        <Fragment set:html={flagSvg(locale)} />
        <span class="rb__code">{locale.toUpperCase()}</span>
        <svg
          class="rb__chevron"
          viewBox="0 0 8 5"
          width="8"
          height="5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M1 1l3 3 3-3" />
        </svg>
      </button>

      <div class="bubble-panel" id="lang-bubble-panel" data-testid="lang-bubble-panel">
        <ul class="bubble-glass rb__list" style="min-width:172px">
          <li>
            <span class="rb__option rb__option--current" aria-current="true">
              <Fragment set:html={flagSvg(locale)} />
              <span class="rb__option-label">{LOCALE_LABELS[locale]}</span>
              <svg
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="rb__check"
              >
                <path d="M3 8l3.5 3.5L13 4" />
              </svg>
            </span>
          </li>
          <li aria-hidden="true">
            <div class="rb__sep"></div>
          </li>
          {otherLocales.map((l) => (
            <li>
              <a
                href={localePath(l, path)}
                hreflang={LOCALE_TAGS[l]}
                lang={LOCALE_TAGS[l]}
                data-lang-link={l}
                data-testid={`lang-option-${l}`}
                class="rb__option"
              >
                <Fragment set:html={flagSvg(l)} />
                <span class="rb__option-label">{LOCALE_LABELS[l]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )}

  {showTheme !== false && (
    <div
      class="bubble-host rb"
      role="group"
      aria-label={t.nav.theme.label}
      data-testid="theme-bubble"
      data-open="false"
    >
      <button
        type="button"
        class="bubble-glass rb__trigger"
        data-bubble-trigger
        aria-expanded="false"
        aria-controls="theme-bubble-panel"
        aria-label={t.nav.theme.label}
        data-testid="theme-bubble-trigger"
        style="width:40px;height:40px;padding:0;justify-content:center"
      >
        {(['system', 'light', 'dark'] as const).map((icon) => (
          <svg
            class="theme-icon"
            data-icon={icon}
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            set:html={THEME_ICONS[icon]}
          />
        ))}
      </button>

      <div class="bubble-panel" id="theme-bubble-panel" data-testid="theme-bubble-panel">
        <ul class="bubble-glass rb__list" style="min-width:176px">
          {themeOptions.map(({ value, label }) => (
            <li>
              <button
                type="button"
                data-set-theme={value}
                aria-pressed="false"
                data-testid={`theme-option-${value}`}
                class="rb__option"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  set:html={THEME_ICONS[value]}
                />
                <span>{label}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}
</div>

<style>
  .site-controls {
    position: fixed;
    top: 0.8125rem;
    right: 1.25rem;
    z-index: 50;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    --sc-accent: var(--project-accent-dark, var(--t-lime-fill));
    --sc-ink: var(--project-accent-ink, var(--t-lime-ink));
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .site-controls {
      --sc-accent: var(--project-accent, var(--t-lime-fill));
    }
  }
  :root[data-theme='light'] .site-controls {
    --sc-accent: var(--project-accent, var(--t-lime-fill));
  }

  /* Trigger button */
  .rb__trigger {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 12px;
    border-radius: 99px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.15s;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .rb__trigger {
      color: rgba(0, 0, 0, 0.6);
    }
    :root:not([data-theme='dark']) .rb__trigger:hover {
      color: rgba(0, 0, 0, 0.9);
    }
  }
  :root[data-theme='light'] .rb__trigger {
    color: rgba(0, 0, 0, 0.6);
  }
  :root[data-theme='light'] .rb__trigger:hover {
    color: rgba(0, 0, 0, 0.9);
  }
  .rb__trigger:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  /* Chevron rotates when open */
  .rb__chevron {
    flex-shrink: 0;
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [data-open='true'] .rb__chevron {
    transform: rotate(180deg);
  }

  /* Locale code label */
  .rb__code {
    letter-spacing: 0.04em;
  }

  /* List in the dropdown */
  .rb__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px;
    border-radius: 16px;
    list-style: none;
    margin: 0;
  }

  /* Option rows (both <a> and <button> variants) */
  .rb__option {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 10px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition:
      background 0.12s,
      color 0.12s;
  }
  .rb__option:hover {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.95);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .rb__option {
      color: rgba(0, 0, 0, 0.65);
    }
    :root:not([data-theme='dark']) .rb__option:hover {
      background: rgba(0, 0, 0, 0.05);
      color: rgba(0, 0, 0, 0.9);
    }
  }
  :root[data-theme='light'] .rb__option {
    color: rgba(0, 0, 0, 0.65);
  }
  :root[data-theme='light'] .rb__option:hover {
    background: rgba(0, 0, 0, 0.05);
    color: rgba(0, 0, 0, 0.9);
  }

  /* Current locale shown as non-interactive span */
  .rb__option--current {
    cursor: default;
    opacity: 0.5;
  }
  .rb__option--current:hover {
    background: none;
  }

  /* Pressed theme option */
  [data-set-theme][aria-pressed='true'] {
    background: var(--sc-accent);
    color: var(--sc-ink);
    font-weight: 600;
  }
  [data-set-theme][aria-pressed='true']:hover {
    background: var(--sc-accent);
    color: var(--sc-ink);
  }

  /* Separator between current locale and alternatives */
  .rb__sep {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 2px 4px;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .rb__sep {
      background: rgba(0, 0, 0, 0.08);
    }
  }
  :root[data-theme='light'] .rb__sep {
    background: rgba(0, 0, 0, 0.08);
  }

  .rb__option-label {
    flex: 1;
    text-align: left;
  }

  .rb__check {
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* Theme icon visibility — only the active one is shown */
  .theme-icon {
    display: none;
  }
  :root:not([data-theme]) .theme-icon[data-icon='system'] {
    display: block;
  }
  :root[data-theme='light'] .theme-icon[data-icon='light'] {
    display: block;
  }
  :root[data-theme='dark'] .theme-icon[data-icon='dark'] {
    display: block;
  }

  /* Mobile: hide chevron and reduce padding */
  @media (max-width: 639px) {
    .rb__chevron {
      display: none;
    }
    .rb__trigger {
      padding: 0 10px;
      gap: 6px;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var hosts = document.querySelectorAll('.bubble-host')
    var timers = new WeakMap()
    function close(h) {
      h.dataset.open = 'false'
      var b = h.querySelector('[data-bubble-trigger]')
      if (b) b.setAttribute('aria-expanded', 'false')
    }
    hosts.forEach(function (host) {
      var trigger = host.querySelector('[data-bubble-trigger]')
      if (!trigger) return
      function open() {
        hosts.forEach(function (h) {
          if (h !== host) close(h)
        })
        host.dataset.open = 'true'
        trigger.setAttribute('aria-expanded', 'true')
      }
      trigger.addEventListener('click', function () {
        if (host.dataset.open === 'true') {
          close(host)
        } else {
          open()
        }
      })
      if (window.matchMedia('(hover: hover)').matches) {
        host.addEventListener('mouseenter', function () {
          clearTimeout(timers.get(host))
          timers.set(host, setTimeout(open, 80))
        })
        host.addEventListener('mouseleave', function () {
          clearTimeout(timers.get(host))
          timers.set(
            host,
            setTimeout(function () {
              close(host)
            }, 220),
          )
        })
      }
      host.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          close(host)
          trigger.focus()
        }
      })
      host.addEventListener('focusout', function (e) {
        if (!host.contains(e.relatedTarget)) close(host)
      })
      host.querySelectorAll('[data-lang-link]').forEach(function (a) {
        a.addEventListener('click', function () {
          try {
            localStorage.lang = a.getAttribute('data-lang-link')
          } catch {}
        })
      })
    })
  })()
</script>
