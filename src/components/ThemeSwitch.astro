---
/**
 * Three-way theme control: system / light / dark. Renders as a segmented
 * group of `aria-pressed` buttons; the handler lives in Base.astro's inline
 * script (stamps `data-theme` on <html> and persists to localStorage).
 * `aria-pressed` defaults to "system" for no-JS / pre-hydration; the script
 * corrects it on load.
 */
import type { Locale } from '../config';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const options = [
  {
    value: 'system',
    label: t.nav.theme.system,
    // half-filled circle
    path: '<circle cx="12" cy="12" r="8.25"/><path d="M12 3.75v16.5A8.25 8.25 0 0 0 12 3.75Z" fill="currentColor" stroke="none"/>',
  },
  {
    value: 'light',
    label: t.nav.theme.light,
    path: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>',
  },
  {
    value: 'dark',
    label: t.nav.theme.dark,
    path: '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>',
  },
] as const;
---

<div
  role="group"
  aria-label={t.nav.theme.label}
  class="flex items-center rounded-full border border-line bg-surface p-0.5"
>
  {
    options.map((o) => (
      <button
        type="button"
        data-set-theme={o.value}
        aria-pressed={o.value === 'system' ? 'true' : 'false'}
        aria-label={o.label}
        title={o.label}
        class="flex h-7 w-7 items-center justify-center rounded-full text-muted transition-colors hover:text-fg aria-pressed:bg-bg aria-pressed:text-lime"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          class="h-4 w-4"
          set:html={o.path}
        />
      </button>
    ))
  }
</div>
