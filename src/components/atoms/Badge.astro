---
/**
 * Small chip used for locale labels, platform tags, and category markers.
 *
 * @slot default — badge text
 */
type Variant = 'outline' | 'filled' | 'accent'

interface Props {
  variant?: Variant
  class?: string
}

const { variant = 'outline', class: cls } = Astro.props
---

<span class:list={['badge', `badge--${variant}`, cls]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    padding: 0.25rem 0.625rem;
  }
  .badge--outline {
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    background: transparent;
  }
  .badge--filled {
    border: 1px solid transparent;
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .badge--accent {
    border: 1px solid transparent;
    background: var(--t-lime-fill);
    color: var(--t-lime-ink);
    font-weight: 600;
  }
</style>
