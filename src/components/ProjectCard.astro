---
import type { Project } from '../content/projects/index';
import { localePath, useTranslations } from '../i18n';
import type { Locale } from '../config';
interface Props { project: Project; locale: Locale }
const { project, locale } = Astro.props;
const t = useTranslations(locale);
const projectT = (t.projects as Record<string, { tagline: string }>)[project.slug];
const emoji = project.platform.includes('ios') ? '📱' : project.platform.includes('cli') ? '⌨️' : '🖥️';
---
<a href={localePath(locale, `/${project.slug}/`)}
   class="group relative flex flex-col gap-4 overflow-hidden rounded-2xl border border-line bg-surface p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--card-accent-mid)] hover:shadow-xl hover:shadow-black/10 focus-visible:outline-2 focus-visible:outline-[var(--t-lime)]"
   style={`--card-accent: ${project.accent}; --card-accent-mid: ${project.accent}55`}>

  <!-- accent top-edge glow on hover -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px opacity-0 transition-opacity duration-300 group-hover:opacity-100"
       style={`background: linear-gradient(90deg, transparent, ${project.accent}90, transparent)`}></div>

  <div class="flex items-start gap-4">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-2xl leading-none"
         style={`background: ${project.accent}18`}>
      {emoji}
    </div>
    <div class="min-w-0 pt-0.5">
      <h2 class="truncate text-sm font-semibold tracking-tight text-fg">{project.name}</h2>
      <p class="mt-1 line-clamp-2 text-sm leading-snug text-muted">{projectT?.tagline ?? ''}</p>
    </div>
  </div>

  <div class="mt-auto flex flex-wrap gap-1.5">
    {project.platform.map((p) => (
      <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">
        {t.directory.platformBadge[p]}
      </span>
    ))}
  </div>
</a>
