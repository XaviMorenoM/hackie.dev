---
/**
 * Theme selector glass pill + dropdown panel (system / light / dark).
 * Extracted from SiteControls — the right bubble showing the active theme icon.
 *
 * @slot — (none; all content is derived from props)
 */
import type { Locale } from '../../config'
import { useTranslations } from '../../i18n'
import { THEME_ICONS } from '../atoms/theme-icons'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const themeOptions = [
  { value: 'system' as const, label: t.nav.theme.system },
  { value: 'light' as const, label: t.nav.theme.light },
  { value: 'dark' as const, label: t.nav.theme.dark },
]
---

<div
  class="bubble-host rb"
  role="group"
  aria-label={t.nav.theme.label}
  data-testid="theme-bubble"
  data-open="false"
>
  <button
    type="button"
    class="bubble-glass rb__trigger rb__trigger--icon"
    data-bubble-trigger
    aria-expanded="false"
    aria-controls="theme-bubble-panel"
    aria-label={t.nav.theme.label}
    data-testid="theme-bubble-trigger"
  >
    {(['system', 'light', 'dark'] as const).map((icon) => (
      <svg
        class="theme-icon"
        data-icon={icon}
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={THEME_ICONS[icon]}
      />
    ))}
  </button>

  <div class="bubble-panel" id="theme-bubble-panel" data-testid="theme-bubble-panel">
    <ul class="bubble-glass rb__list" style="min-width:176px">
      {themeOptions.map(({ value, label }) => (
        <li>
          <button
            type="button"
            data-set-theme={value}
            aria-pressed="false"
            data-testid={`theme-option-${value}`}
            class="rb__option"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
              set:html={THEME_ICONS[value]}
            />
            <span>{label}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Trigger button — .bubble-glass (from global.css @layer components) owns
     background, border and backdrop-filter. Only layout and colour go here. */
  .rb__trigger {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 12px;
    border-radius: 99px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.15s;
  }
  .rb__trigger--icon {
    width: 40px;
    padding: 0;
    justify-content: center;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .rb__trigger {
      color: rgba(0, 0, 0, 0.6);
    }
    :root:not([data-theme='dark']) .rb__trigger:hover {
      color: rgba(0, 0, 0, 0.9);
    }
  }
  :root[data-theme='light'] .rb__trigger {
    color: rgba(0, 0, 0, 0.6);
  }
  :root[data-theme='light'] .rb__trigger:hover {
    color: rgba(0, 0, 0, 0.9);
  }
  .rb__trigger:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  /* List in the dropdown */
  .rb__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px;
    border-radius: 16px;
    list-style: none;
    margin: 0;
  }

  /* Option rows */
  .rb__option {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 10px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition:
      background 0.12s,
      color 0.12s;
  }
  .rb__option:hover {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.95);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .rb__option {
      color: rgba(0, 0, 0, 0.65);
    }
    :root:not([data-theme='dark']) .rb__option:hover {
      background: rgba(0, 0, 0, 0.05);
      color: rgba(0, 0, 0, 0.9);
    }
  }
  :root[data-theme='light'] .rb__option {
    color: rgba(0, 0, 0, 0.65);
  }
  :root[data-theme='light'] .rb__option:hover {
    background: rgba(0, 0, 0, 0.05);
    color: rgba(0, 0, 0, 0.9);
  }

  /* Pressed theme option */
  [data-set-theme][aria-pressed='true'] {
    background: var(--sc-accent);
    color: var(--sc-ink);
    font-weight: 600;
  }
  [data-set-theme][aria-pressed='true']:hover {
    background: var(--sc-accent);
    color: var(--sc-ink);
  }

  /* Theme icon visibility — only the active one is shown */
  .theme-icon {
    display: none;
  }
  :root:not([data-theme]) .theme-icon[data-icon='system'] {
    display: block;
  }
  :root[data-theme='light'] .theme-icon[data-icon='light'] {
    display: block;
  }
  :root[data-theme='dark'] .theme-icon[data-icon='dark'] {
    display: block;
  }
</style>
