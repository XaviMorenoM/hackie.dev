---
/**
 * CSS-only iPhone-style frame. Wrap an `<Image>`/`<video>` or leave the slot
 * empty to render a tasteful placeholder screen.
 */
interface Props {
  class?: string;
  /** Vary the placeholder composition so a row of frames doesn't look cloned. */
  variant?: 0 | 1 | 2 | 3 | 4 | 5;
  label?: string;
}
const { class: extra = '', variant = 0, label } = Astro.props;
const hasContent = Astro.slots.has('default');
const bars = [
  [72, 48, 60, 36],
  [40, 64, 52, 76],
  [58, 30, 70, 44],
  [66, 56, 38, 62],
  [34, 70, 46, 58],
  [50, 42, 68, 32],
][variant]!;
---

<div
  class:list={[
    'relative aspect-[9/19.5] w-full overflow-hidden rounded-phone border-[6px] border-[#1c1c1f] bg-black shadow-[0_30px_80px_-30px_rgba(0,0,0,0.9),inset_0_0_0_1px_rgba(255,255,255,0.06)]',
    extra,
  ]}
>
  <span
    aria-hidden="true"
    class="absolute top-2.5 left-1/2 z-10 h-6 w-[38%] -translate-x-1/2 rounded-full bg-black"
  ></span>

  {
    hasContent ? (
      <slot />
    ) : (
      /* TODO(media): replaced automatically once real screenshots land in src/assets/screenshots/<locale>/ */
      <div class="flex h-full flex-col justify-end gap-3 bg-bg p-[7%] pt-[18%]" aria-hidden="true">
        <p class="display text-[1.35rem] leading-none text-fg">
          {['today', 'workout', 'routine', 'progress', 'library', 'you'][variant]}
          <span class="text-lime">.</span>
        </p>
        <div class="mt-auto space-y-2">
          <div class="rounded-2xl bg-lime p-[7%]">
            <div class="h-2 w-1/2 rounded-full bg-lime-ink/80" />
            <div class="mt-2 h-1.5 w-3/4 rounded-full bg-lime-ink/40" />
          </div>
          <div class="flex items-end gap-1.5 rounded-2xl bg-surface p-[7%]">
            {bars.map((h) => (
              <span class="block w-full rounded-sm bg-muted/40" style={`height:${h}px`} />
            ))}
          </div>
          <div class="rounded-2xl bg-surface p-[7%]">
            <div class="h-1.5 w-2/3 rounded-full bg-muted/60" />
            <div class="mt-2 h-1.5 w-1/3 rounded-full bg-muted/30" />
          </div>
        </div>
        {label && (
          <p class="mt-3 text-center text-[0.65rem] font-semibold tracking-widest text-muted uppercase">{label}</p>
        )}
      </div>
    )
  }
</div>
