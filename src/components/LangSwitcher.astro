---
import { LOCALES, LOCALE_LABELS, LOCALE_TAGS, type Locale } from '../config';
import { localePath, stripLocale, useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const path = stripLocale(Astro.url.pathname);
---

<nav aria-label={t.nav.language}>
  <ul class="flex items-center gap-1 text-xs font-semibold tracking-wide uppercase">
    {
      LOCALES.map((l, i) => (
        <li class="flex items-center">
          {i > 0 && <span aria-hidden="true" class="mx-1 text-line">/</span>}
          {l === locale ? (
            <span aria-current="page" class="px-1 text-lime">
              {l}
            </span>
          ) : (
            <a
              href={localePath(l, path)}
              hreflang={LOCALE_TAGS[l]}
              lang={LOCALE_TAGS[l]}
              title={LOCALE_LABELS[l]}
              class="px-1 text-muted transition-colors hover:text-fg"
            >
              {l}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
