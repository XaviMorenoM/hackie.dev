---
/**
 * Screenshot carousel. Reads `src/assets/screenshots/<locale>/*.{png,jpg,jpeg,webp}`
 * at build time (sorted by filename). `ca` reuses `es`; an empty locale folder
 * falls back to `en`; no screenshots at all → CSS phone-frame placeholders.
 *
 * TODO(media): drop the real exports from media/screenshots/{en,es} into
 * src/assets/screenshots/{en,es} — nothing else needs to change.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../config';
import { useTranslations } from '../i18n';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const all = import.meta.glob<ImageMetadata>('../assets/screenshots/*/*.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});

function shotsFor(folder: string): ImageMetadata[] {
  return Object.entries(all)
    .filter(([path]) => path.includes(`/screenshots/${folder}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, img]) => img);
}

const folder = locale === 'ca' ? 'es' : locale;
const shots = shotsFor(folder).length ? shotsFor(folder) : shotsFor('en');
const placeholders = shots.length ? [] : ([0, 1, 2, 3, 4, 5] as const);
const altFor = (i: number) => t.product.screenshotAlts[Math.min(i, t.product.screenshotAlts.length - 1)]!;
---

<div class="relative -mx-5 sm:-mx-8">
  <ul
    class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-6 sm:px-8 [scrollbar-width:thin] [scrollbar-color:var(--color-line)_transparent]"
    role="list"
  >
    {
      shots.map((img, i) => (
        <li class="w-[68vw] shrink-0 snap-center sm:w-[280px]">
          <PhoneFrame>
            <Image
              src={img}
              alt={altFor(i)}
              widths={[280, 420, 560]}
              sizes="(min-width: 640px) 280px, 68vw"
              format="webp"
              quality={82}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover"
            />
          </PhoneFrame>
        </li>
      ))
    }
    {
      placeholders.map((i) => (
        <li class="w-[68vw] shrink-0 snap-center sm:w-[280px]">
          <PhoneFrame variant={i} label={t.product.placeholderLabel} />
          <span class="sr-only">{altFor(i)}</span>
        </li>
      ))
    }
  </ul>
</div>
