---
import Base from '../../layouts/Base.astro'
import Button from '../../components/Button.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { getAllProjects } from '../../content/projects/index'
import { localeStaticPaths, useTranslations } from '../../i18n'
import { CONTACT_EMAIL, DEVELOPER_LINKEDIN, type Locale } from '../../config'
import '../../content/projects/alterio/index'
import '../../content/projects/diskspace/index'

export const getStaticPaths = localeStaticPaths
const locale = Astro.params.locale as Locale
const t = useTranslations(locale)
const projects = getAllProjects()
const gridClass =
  projects.length === 1 ? 'grid gap-5 max-w-xs' : 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3'
---

<Base locale={locale} title="hackie.dev" description={t.directory.intro}>
  <!-- section 1: hero -->
  <section
    aria-labelledby="home-hero-h"
    data-testid="home-hero"
    class="mx-auto max-w-5xl px-5 pt-20 pb-14 sm:px-8 sm:pt-28 sm:pb-16"
  >
    <h1
      id="home-hero-h"
      class="text-4xl font-bold tracking-tight text-balance text-fg sm:text-6xl lg:text-7xl"
    >
      Xavi Moreno
      <span class="text-lime" aria-hidden="true">
        .
      </span>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted text-pretty sm:text-2xl sm:leading-snug">
      {t.directory.intro}
    </p>
    <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <span class="h-px w-6 shrink-0 bg-lime" aria-hidden="true"></span>
      <span>Barcelona</span>
      <span class="text-lime" aria-hidden="true">
        ·
      </span>
      <span>{t.directory.bio}</span>
    </p>
  </section>

  <!-- section 2: work (conditional) -->
  {projects.length > 0 && (
    <section
      aria-labelledby="home-work-h"
      id="home-work"
      data-testid="home-work"
      class="mx-auto max-w-5xl px-5 pb-24 sm:px-8"
    >
      <h2 id="home-work-h" class="eyebrow mb-8">
        {t.directory.work}
      </h2>
      <div class={gridClass}>
        {projects.map((p) => (
          <ProjectCard project={p} locale={locale} />
        ))}
      </div>
    </section>
  )}

  <!-- section 3: how I build -->
  <section
    aria-labelledby="home-how-h"
    data-testid="home-how"
    class="mx-auto max-w-5xl px-5 pb-24 sm:px-8"
  >
    <h2 id="home-how-h" class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
      {t.directory.howHeading}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">{t.directory.howIntro}</p>
    <ol class="mt-8 grid gap-8 sm:grid-cols-3">
      {t.directory.howSteps.map((s, i) => (
        <li class="border-t border-line pt-4">
          <span class="text-sm font-semibold text-muted tabular-nums" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-2 text-base font-semibold text-fg">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- section 4: contact -->
  <section
    aria-labelledby="home-contact-h"
    data-testid="home-contact"
    class="mx-auto max-w-5xl px-5 pb-28 sm:px-8"
  >
    <h2 id="home-contact-h" class="text-2xl font-bold tracking-tight text-fg sm:text-3xl">
      {t.directory.contactHeading}
    </h2>
    <p class="mt-3 max-w-xl text-lg text-muted">{t.directory.contactBody}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href={`mailto:${CONTACT_EMAIL}`} variant="primary">
        xavier.moreno.
        <wbr />
        martinez
        <wbr />
        @gmail.com
      </Button>
      <Button href={DEVELOPER_LINKEDIN} variant="secondary" external>
        {t.directory.contactLinkedin}
      </Button>
    </div>
  </section>
</Base>
